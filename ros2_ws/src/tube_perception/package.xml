<?xml version="1.0"?>
<package format="3">
  <name>tube_perception</name>
  <version>0.1.0</version>
  <description>Static-image tube candidate detection for the Tube Positioning project.</description>

  <maintainer email="dev@example.com">Tube Positioning Development</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tube_interfaces</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
